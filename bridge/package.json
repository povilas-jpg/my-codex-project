{
  "name": "claude-glasses-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Bridges Even Realities G2 smart glasses to a claude-pad session: speech in, Claude's replies on the lens.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:cloud": "tsx src/cloud/server.ts",
    "start:cloud": "node dist/bridge/src/cloud/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mentra/sdk": "^2.1.29"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
